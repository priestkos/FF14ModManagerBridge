<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FF14ModManagerBridge.Tests</AssemblyName>
  </PropertyGroup>

  <!-- The pipe protocol is deliberately Dalamud-free, so it can be linked and run here without the game. -->
  <ItemGroup>
    <Compile Include="../FF14ModManagerBridge/Core/Bridge.cs" Link="Core/Bridge.cs" />
  </ItemGroup>

</Project>
